# Copy to .env.local for local development, and set the same variables in
# Netlify: Project configuration → Environment variables.
# Every value is optional — anything left empty is hidden on the site.

# Brand (temporary name is used until set)
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_SHORT_NAME=

# Public site URL, used for SEO / Open Graph. Netlify provides URL automatically.
NEXT_PUBLIC_SITE_URL=

# Contact details
NEXT_PUBLIC_WHATSAPP_NUMBER=          # digits only, international format, e.g. 2547XXXXXXXX
NEXT_PUBLIC_WHATSAPP_DISPLAY=         # e.g. +254 7XX XXX XXX
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_BUSINESS_LOCATION=        # e.g. Nairobi, Kenya
NEXT_PUBLIC_BUSINESS_HOURS=           # e.g. Mon–Sat, 8am–6pm EAT

# Social profiles (full URLs)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Analytics (leave empty to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=        # e.g. G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=
